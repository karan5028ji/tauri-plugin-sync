{
  "name": "tauri-plugin-sync",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-Configuration Local-First SQLite Replication & Sync Engine for Tauri v2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "prepublishOnly": "npm run build"
  },
  "author": "Karan Gupta (Gupta Ventures)",
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
